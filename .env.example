# Model provider key: set the one that matches --model / AGENT_MODEL.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# Sandbox: e2b when E2B_API_KEY is set, else docker when Docker is running, else local.
# AGENT_SANDBOX=docker
# AGENT_DOCKER_IMAGE=node:22-bookworm
# E2B_API_KEY=

# Defaults for minecraft-agent. Command-line flags override these.
# MC_HOST=localhost
# MC_PORT=25565
# MC_AUTH=offline
# AGENT_MODEL=openai/gpt-6.1-terra
# AGENT_NAME=Agent
# AGENT_OBJECTIVE=Gather wood and build a small shelter near spawn

# OpenAI Responses compatible endpoint (LiteLLM, vLLM, a gateway). Used with --base-url.
# MODEL_BASE_URL=
# MODEL_API_KEY=
