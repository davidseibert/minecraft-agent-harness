#!/usr/bin/env bash
set -euo pipefail
RELAY="${TOOL_RELAY_URL:-http://127.0.0.1:7777}"; TOKEN="${TOOL_API_TOKEN:?TOOL_API_TOKEN not set}"
TOOLS_JSON="/opt/harness/tools.json"
PYLIST='import json,sys
for t in json.load(open(sys.argv[1])): print("%-22s %s" % (t["name"], t["description"][:110]))'
PYHELP='import json,sys
for t in json.load(open(sys.argv[1])):
    if t["name"]==sys.argv[2]: print(json.dumps(t,indent=1))'
if [[ "${1:-}" == "--list" ]]; then python3 -c "$PYLIST" "$TOOLS_JSON"; exit 0; fi
if [[ "${1:-}" == "--help" ]]; then python3 -c "$PYHELP" "$TOOLS_JSON" "${2:?name}"; exit 0; fi
NAME="${1:?usage: tool <name> [json-args]}"; ARGS="${2:-{\}}"
BODY=$(python3 -c 'import json,sys
try: a=json.loads(sys.argv[2])
except Exception: sys.stderr.write("args must be a JSON object\n"); sys.exit(2)
if not isinstance(a,dict): sys.stderr.write("args must be a JSON object\n"); sys.exit(2)
print(json.dumps({"name":sys.argv[1],"args":a}))' "$NAME" "$ARGS")
RESP=$(curl -sS --max-time 605 -H "x-token: $TOKEN" -H 'content-type: application/json' -d "$BODY" "$RELAY/call")
python3 -c 'import json,sys
r=json.loads(sys.stdin.read())
if r.get("ok"): print(json.dumps(r.get("result"),separators=(",",":"))); sys.exit(0)
sys.stderr.write((r.get("error") or "tool failed")+"\n"); sys.exit(1)' <<<"$RESP"
